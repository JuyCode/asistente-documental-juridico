# OPCION A: Copia este archivo como .streamlit/secrets.toml para desarrollo local.
# OPCION B (producción / Streamlit Cloud): pega el contenido en
#    Settings -> Secrets  del panel de tu app (NO crear archivos en el repo).

# Solo una de las dos claves es necesaria, según PROVIDER que elijas.
PROVIDER = "gemini"           # "gemini" | "openai"

GEMINI_API_KEY = "AIza..."
OPENAI_API_KEY = "sk-..."

# Opcional: modelos y vector DB ---------------------------------------------------
# LLM_MODEL = "models/gemini-3.6-flash"
# EMBEDDING_MODEL = "models/gemini-embedding-2"
# QDRANT_URL = "https://xxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333"
# QDRANT_API_KEY = "tu_clave"
# QDRANT_COLLECTION = "legal_contable_docs"
# MIN_SIMILARITY_SCORE = "0.50"
# TOP_K = "4"