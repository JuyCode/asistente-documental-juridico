# Configuración local (desarrollo). Copia este archivo como `.env`
# y NO lo subas a GitHub (está en .gitignore).

# --- Proveedor: "gemini" (recomendado) u "openai" ---------------------
PROVIDER=gemini

# --- Claves de API -----------------------------------------------------
# Gemini: obténla gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# OpenAI (alternativa): https://platform.openai.com
OPENAI_API_KEY=sk-...

# --- Modelos (opcional, hay defaults) ----------------------------------
# LLM_MODEL=models/gemini-3.6-flash
# EMBEDDING_MODEL=models/gemini-embedding-2
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# --- Vector DB en la nube: Qdrant Cloud (OPCIONAL) ---------------------
# Deja vacías estas 3 variables para usar el modo local (./data).
# Si las configuras, la app usará Qdrant Cloud (persistencia real).
# Registro gratis en https://cloud.qdrant.io/ -> crear cluster "free".
# QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=tu_clave_qdrant
# QDRANT_COLLECTION=legal_contable_docs

# --- Calidad/estrictez ---------------------------------------------------
# Umbral 0..1. Recomendado 0.50 con Gemini (gemini-embedding-2) / 0.70 con OpenAI.
# MIN_SIMILARITY_SCORE=0.50
# TOP_K=4
# LOCAL_PERSIST_DIR=data/index